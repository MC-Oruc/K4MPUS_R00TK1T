; =========================================================================
; === Gizli Veriler (Secrets) - ÖRNEK DOSYA ===
; =========================================================================
; Bu dosyayı 'secrets.ini' olarak kopyalayın ve kendi bilgilerinizle doldurun.
; 'secrets.ini' dosyası .gitignore'da olduğu için paylaşılmayacaktır.

[wifi]
    ; --- Station (STA) Modu Ayarları ---
    ; Mevcut bir ağa bağlanmak için
    sta_ssid = "YourWiFiSSID"
    sta_pass = "YourWiFiPass"

    ; --- Access Point (AP) Modu Ayarları ---
    ; Kendi ağını oluşturmak için
    ap_ssid = "DeviceName"
    ap_pass = "DevicePass"
